{
    "name": "superprompt-api",
    "version": "2.0.0",
    "description": "Production-grade API for SuperPrompt Chrome Extension",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "build": "echo 'No build needed for serverless functions'",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:auth": "jest --testPathPattern=auth",
        "test:prompts": "jest --testPathPattern=prompts",
        "test:enhance": "jest --testPathPattern=enhance",
        "test:integration": "jest --testPathPattern=integration",
        "lint": "eslint . --ext .js",
        "lint:fix": "eslint . --ext .js --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "db:seed": "node scripts/seed.js",
        "db:migrate": "node scripts/migrate.js",
        "logs:view": "tail -f logs/combined.log",
        "logs:error": "tail -f logs/error.log",
        "security:audit": "npm audit && snyk test",
        "docker:build": "docker build -t superprompt-api .",
        "docker:run": "docker run -p 3000:3000 superprompt-api",
        "docs:generate": "swagger-jsdoc -d swaggerDef.js routes/*.js -o docs/swagger.json",
        "precommit": "npm run lint && npm run test",
        "prepush": "npm run test:coverage"
    },
    "dependencies": {
        "@sentry/node": "^7.81.1",
        "bcryptjs": "^2.4.3",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "express-validator": "^7.0.1",
        "helmet": "^7.1.0",
        "isomorphic-dompurify": "^2.11.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.0.3",
        "node-fetch": "^3.3.2",
        "nodemailer": "^6.10.1",
        "openai": "^4.20.1",
        "winston": "^3.11.0",
        "winston-daily-rotate-file": "^4.7.1",
        "winston-papertrail": "^1.0.5"
    },
    "devDependencies": {
        "@types/jest": "^29.5.8",
        "eslint": "^8.55.0",
        "eslint-config-node": "^4.1.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-node": "^11.1.0",
        "eslint-plugin-security": "^1.7.1",
        "husky": "^8.0.3",
        "jest": "^29.7.0",
        "lint-staged": "^15.2.0",
        "mongodb-memory-server": "^9.1.3",
        "nodemon": "^3.0.2",
        "prettier": "^3.1.1",
        "snyk": "^1.1276.0",
        "supertest": "^6.3.3",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.0"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    },
    "jest": {
        "testEnvironment": "node",
        "setupFilesAfterEnv": [
            "<rootDir>/tests/setup.js"
        ],
        "collectCoverageFrom": [
            "**/*.js",
            "!node_modules/**",
            "!tests/**",
            "!coverage/**",
            "!logs/**",
            "!docs/**"
        ],
        "coverageDirectory": "coverage",
        "coverageReporters": [
            "text",
            "lcov",
            "html"
        ],
        "coverageThreshold": {
            "global": {
                "branches": 80,
                "functions": 80,
                "lines": 80,
                "statements": 80
            }
        }
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged",
            "pre-push": "npm run test"
        }
    },
    "lint-staged": {
        "*.js": [
            "eslint --fix",
            "prettier --write",
            "git add"
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/your-username/superprompt.git"
    },
    "keywords": [
        "api",
        "chrome-extension",
        "ai",
        "prompts",
        "node.js",
        "express",
        "mongodb"
    ],
    "author": "SuperPrompt Team",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/your-username/superprompt/issues"
    },
    "homepage": "https://github.com/your-username/superprompt#readme"
}