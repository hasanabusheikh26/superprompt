# SuperPrompt API Environment Configuration
# Copy this file to .env and fill in your actual values

# ================================
# Server Configuration
# ================================
NODE_ENV=development
PORT=3000
API_VERSION=2.0.0
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# ================================
# Database Configuration
# ================================
MONGODB_URI=mongodb://localhost:27017/superprompt
MONGODB_URI_TEST=mongodb://localhost:27017/superprompt_test

# Database connection options
DB_MAX_CONNECTIONS=10
DB_TIMEOUT=30000

# ================================
# Authentication & Security
# ================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Session configuration
SESSION_SECRET=your-session-secret-change-this
SESSION_MAX_AGE=604800000

# API Keys
API_KEY=your-api-key-for-external-access

# ================================
# Email Configuration
# ================================
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@superprompt.com

# Alternative SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# ================================
# AI/OpenAI Configuration
# ================================
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# AI usage limits
AI_REQUESTS_PER_HOUR=100
AI_TOKENS_PER_DAY=50000

# ================================
# Storage Configuration
# ================================
MAX_REQUEST_SIZE=10mb
MAX_FILE_SIZE=5mb
UPLOAD_PATH=./uploads

# Cloud storage (optional)
AWS_REGION=us-east-1
AWS_S3_BUCKET=superprompt-files
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ================================
# Logging Configuration
# ================================
LOG_LEVEL=info
LOG_FILE_MAX_SIZE=5m
LOG_FILE_MAX_FILES=5
LOG_DIRECTORY=./logs

# External logging (optional)
PAPERTRAIL_HOST=logs.papertrailapp.com
PAPERTRAIL_PORT=12345
SENTRY_DSN=your-sentry-dsn

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5

# ================================
# Cache Configuration
# ================================
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600
CACHE_MAX_SIZE=100

# ================================
# OAuth Configuration
# ================================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# ================================
# Payment Configuration (Stripe)
# ================================
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_ID_PRO=price_your-pro-price-id
STRIPE_PRICE_ID_ENTERPRISE=price_your-enterprise-price-id

# ================================
# Monitoring & Analytics
# ================================
# Application monitoring
NEW_RELIC_LICENSE_KEY=your-newrelic-license-key
DATADOG_API_KEY=your-datadog-api-key

# User analytics
MIXPANEL_TOKEN=your-mixpanel-token
GOOGLE_ANALYTICS_ID=GA-123456789

# ================================
# Security Configuration
# ================================
# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,chrome-extension://*

# Content Security Policy
CSP_ENABLED=true
CSP_REPORT_URI=https://your-csp-report-endpoint.com

# Rate limiting
ENABLE_RATE_LIMITING=true
TRUST_PROXY=false

# ================================
# Feature Flags
# ================================
FEATURE_EMAIL_VERIFICATION=true
FEATURE_TWO_FACTOR_AUTH=false
FEATURE_ANALYTICS=true
FEATURE_COLLABORATION=true
FEATURE_AI_ENHANCEMENT=true
FEATURE_PUBLIC_PROMPTS=true

# ================================
# Development Configuration
# ================================
# Debug options
DEBUG_ENABLED=false
DEBUG_NAMESPACE=superprompt:*

# Development tools
HOT_RELOAD=true
MOCK_EMAIL=true
MOCK_PAYMENTS=true

# ================================
# Production Configuration
# ================================
# SSL/TLS
SSL_ENABLED=false
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem

# Performance
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6

# Health checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000

# ================================
# Deployment Configuration
# ================================
# Vercel
VERCEL_TOKEN=your-vercel-token
VERCEL_PROJECT_ID=your-project-id

# Docker
DOCKER_REGISTRY=your-registry.com
DOCKER_IMAGE_TAG=latest

# Kubernetes
K8S_NAMESPACE=superprompt
K8S_CONFIG_PATH=./k8s-config.yaml